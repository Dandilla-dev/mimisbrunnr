datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Пользователь, который пишет заметки
model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  notes Note[]
}

model Note {
  id       Int    @id @default(autoincrement())
  text     String
  author   User   @relation(fields: [authorId], references: [id])
  authorId Int
  @@map("notes")
}
