{
  "name": "mimisbrunnr",
  "productName": "Mimisbrunnr",
  "version": "0.5.4",
  "description": "Mímisbrunnr — разбирает код репозитория и объясняет его простыми словами",
  "author": "Danila Gorshunov",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env MAGISTR_DEV=1 electron .\"",
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "test": "node tests/core.test.mjs",
    "dist": "vite build && electron-builder",
    "dist:linux": "vite build && electron-builder --linux AppImage",
    "dist:win": "vite build && electron-builder --win nsis",
    "dist:mac": "vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "sql.js": "1.15.2",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@reduxjs/toolkit": "2.14.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "44.10.2",
    "electron-builder": "26.18.1",
    "elkjs": "^0.10.0",
    "highlight.js": "11.12.0",
    "postcss": "8.5.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.3.1",
    "tailwindcss": "3.4.19",
    "vite": "5.4.21",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "dev.dandilla.mimisbrunnr",
    "productName": "Mimisbrunnr",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "core/**",
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tree-sitter-wasms/out/*.wasm",
      "node_modules/sql.js/dist/*.wasm",
      "node_modules/web-tree-sitter/*.wasm"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "Mimisbrunnr",
          "Name": "Mímisbrunnr"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  },
  "desktopName": "mimisbrunnr.desktop"
}
